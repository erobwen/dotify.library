<obfl xmlns="http://www.daisy.org/ns/2011/obfl" version="2011-1" xml:lang="en">
	<meta xmlns:dc="http://purl.org/dc/elements/1.1/">
		<dc:title>Nested list test</dc:title>
		<dc:description>Tests nested lists where every item carries the indent (block-indent, first-line-indent and text-indent) and the content is in child blocks. The label of a nested item is placed at the text column of the item above.</dc:description>
	</meta>
	<layout-master name="body" page-width="20" page-height="12" duplex="false">
		<default-template>
			<header/>
			<footer/>
		</default-template>
	</layout-master>
	<sequence master="body">
		<block list-type="ol">
			<block block-indent="3" first-line-indent="3" text-indent="3">
				<block>⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤</block>
				<block list-type="ol" list-style="a">
					<block block-indent="3" first-line-indent="3" text-indent="3"><block>⠤⠤⠤</block></block>
					<block block-indent="3" first-line-indent="3" text-indent="3">
						<block>⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤</block>
						<block list-type="ol" list-style="i">
							<block block-indent="3" first-line-indent="3" text-indent="3"><block>⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤</block></block>
						</block>
						<block>⠤⠤⠤ ⠤⠤⠤</block>
					</block>
				</block>
				<block>⠤⠤⠤ ⠤⠤⠤</block>
			</block>
			<block block-indent="3" first-line-indent="3" text-indent="3"><block>⠤⠤⠤</block></block>
		</block>
	</sequence>
</obfl>
