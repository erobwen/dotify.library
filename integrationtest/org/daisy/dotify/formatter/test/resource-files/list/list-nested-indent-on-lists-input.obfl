<obfl xmlns="http://www.daisy.org/ns/2011/obfl" version="2011-1" xml:lang="en">
	<meta xmlns:dc="http://purl.org/dc/elements/1.1/">
		<dc:title>Nested list test</dc:title>
		<dc:description>Tests nested lists where every list carries the indent (block-indent) and the items carry nothing. A list's block-indent reserves the room for its labels; the label of a nested item is placed at the text column of the item above.</dc:description>
	</meta>
	<layout-master name="body" page-width="20" page-height="12" duplex="false">
		<default-template>
			<header/>
			<footer/>
		</default-template>
	</layout-master>
	<sequence master="body">
		<block list-type="ol" block-indent="3">
			<block>
				<block>⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤</block>
				<block list-type="ol" list-style="a" block-indent="3">
					<block>⠤⠤⠤</block>
					<block>
						<block>⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤</block>
						<block list-type="ol" list-style="i" block-indent="3">
							<block>⠤⠤⠤ ⠤⠤⠤ ⠤⠤⠤</block>
						</block>
						<block>⠤⠤⠤ ⠤⠤⠤</block>
					</block>
				</block>
				<block>⠤⠤⠤ ⠤⠤⠤</block>
			</block>
			<block>⠤⠤⠤</block>
		</block>
	</sequence>
</obfl>
