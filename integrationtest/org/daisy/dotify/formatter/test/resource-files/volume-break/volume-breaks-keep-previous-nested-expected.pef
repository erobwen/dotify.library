<?xml version="1.0" encoding="UTF-8"?>
<pef version="2008-1" xmlns="http://www.daisy.org/ns/2008/pef">
<head>
<meta xmlns:dc="http://purl.org/dc/elements/1.1/">
<dc:format>application/x-pef+xml</dc:format>
<dc:identifier>identifier?</dc:identifier>
<dc:date>2026-10-15</dc:date>
<dc:title>Volume keep with previous, nested blocks ending together test</dc:title>
<dc:description>One short block is one sheet. A block with keep-with-previous-sheets=&quot;1&quot; contains only a block with keep-with-previous-sheets=&quot;2&quot;, which fills sheets 3-5, so both blocks end on sheet 5. Each keep must apply on its own: the inner keep keeps sheets 3-5 together. Without any keep, the volumes would be 4 and 2 sheets. With only the outer keep, they would be 3 and 3 sheets. With both, they are 2 and 4 sheets.</dc:description>
</meta>
</head>
